    "@sveltejs/vite-plugin-svelte": "^6.1.3",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^24.3.0",
    "daisyui": "^5.0.50",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.11.0",
    "globals": "^16.3.0",
    "litestar-vite-plugin": "^0.25.0",
    "prettier": "^3.6.2",
    "prettier-plugin-svelte": "^4.1.1",
